//! Document step · eContent SHA-1 · data groups SHA-1 · eContent ≤ 1024 bytes.
//!
//! Generated by `eid-vectors circuits`; specification: docs/circuits/document.md.

use eid_hash::sha1_var;
use eid_steps::document::{
    assert_hash_at, assert_message_digest, check, OID_SHA1, OUTPUT_FIELDS, outputs, Witness,
};

/// Takes the proof date (unix seconds), the nullifier scope (0 for none) and
/// the salt of DG1's payload commitment, and returns `[c_B, payload_commitment,
/// date, scope, nullifier]` through the databus, to the pipeline kernel that
/// folds this step (noir-zk).
fn main(
    date: u64,
    scope: Field,
    dg1_salt: Field,
    w: Witness<1024>,
) -> return_data [Field; OUTPUT_FIELDS] {
    let p = check::<1024, 7, 20>(date, w, OID_SHA1);
    assert_message_digest(w, sha1_var(w.econtent, p.lds.len));
    assert_hash_at(w.econtent, p.lds.dg1_hash_at, sha1_var(w.dg1, p.dg1.len));
    outputs(date, scope, dg1_salt, w, p)
}
