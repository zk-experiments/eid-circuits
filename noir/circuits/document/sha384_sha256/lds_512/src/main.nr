//! Document step · eContent SHA-384 · data groups SHA-256 · eContent ≤ 512 bytes.
//!
//! Generated by `eid-vectors circuits`; specification: docs/circuits/document.md.

use eid_hash::{sha256_var, sha384_var};
use eid_steps::document::{
    assert_hash_at, assert_message_digest, check, OID_SHA256, OUTPUT_FIELDS, outputs, Witness,
};

/// Takes the proof date (unix seconds), the nullifier scope (0 for none) and
/// the salt of DG1's payload commitment, and returns `[c_B, payload_commitment,
/// date, scope, nullifier]` through the databus, to the pipeline kernel that
/// folds this step (noir-zk).
fn main(
    date: u64,
    scope: Field,
    dg1_salt: Field,
    w: Witness<512>,
) -> return_data [Field; OUTPUT_FIELDS] {
    let p = check::<512, 11, 32>(date, w, OID_SHA256);
    assert_message_digest(w, sha384_var(w.econtent, p.lds.len));
    assert_hash_at(w.econtent, p.lds.dg1_hash_at, sha256_var(w.dg1, p.dg1.len));
    outputs(date, scope, dg1_salt, w, p)
}
