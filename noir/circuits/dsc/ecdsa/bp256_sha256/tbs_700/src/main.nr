//! DSC step · ECDSA · bp256 · SHA256 · TBSCertificate ≤ 700 bytes.
//!
//! Generated by `eid-vectors circuits`; specification: docs/circuits/dsc.md.

use eid_ecdsa::verify_bp256;
use eid_hash::sha256_var;
use eid_steps::dsc::{check, commitment, KeyKind, Witness};
use eid_steps::HASH_SHA256;

/// Returns `[registry root, commitment]` through the databus, to the DSC
/// kernel that folds this proof.
fn main(
    root: Field,
    salt: Field,
    w: Witness<700, 64>,
    r: [u8; 32],
    s: [u8; 32],
) -> return_data [Field; 2] {
    let f = check::<700, 64, 3>(root, w, KeyKind { key_type: 2, curve: 12, bits: 256 });
    let mut x: [u8; 32] = [0; 32];
    let mut y: [u8; 32] = [0; 32];
    for i in 0..32 {
        x[i] = w.csca_key[i];
        y[i] = w.csca_key[32 + i];
    }
    verify_bp256::<32>(x, y, r, s, sha256_var(w.tbs, f.len));
    [root, commitment(salt, w.header.country, HASH_SHA256, w.tbs, f.len)]
}
