//! DSC step · ECDSA · bp256 · SHA512 · TBSCertificate ≤ 1600 bytes.
//!
//! Generated by `eid-vectors circuits`; specification: docs/circuits/dsc.md.

use eid_ecdsa::verify_bp256;
use eid_hash::sha512_var;
use eid_steps::dsc::{check, commitment, KeyKind, Witness};
use eid_steps::HASH_SHA512;

/// Public: registry root. Returns `[commitment, hash id]`.
fn main(
    root: pub Field,
    salt: Field,
    w: Witness<1600, 64>,
    r: [u8; 32],
    s: [u8; 32],
) -> pub [Field; 2] {
    let f = check::<1600, 64, 3>(root, w, KeyKind { key_type: 2, curve: 12, bits: 256 });
    let mut x: [u8; 32] = [0; 32];
    let mut y: [u8; 32] = [0; 32];
    for i in 0..32 {
        x[i] = w.csca_key[i];
        y[i] = w.csca_key[32 + i];
    }
    verify_bp256::<64>(x, y, r, s, sha512_var(w.tbs, f.len));
    [commitment(salt, w.header.country, HASH_SHA512, w.tbs, f.len), HASH_SHA512 as Field]
}
