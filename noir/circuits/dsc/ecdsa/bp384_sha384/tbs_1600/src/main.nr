//! DSC step · ECDSA · bp384 · SHA384 · TBSCertificate ≤ 1600 bytes.
//!
//! Generated by `eid-vectors circuits`; specification: docs/circuits/dsc.md.

use eid_ecdsa::verify_bp384;
use eid_hash::sha384_var;
use eid_steps::dsc::{check, commitment, KeyKind, Witness};
use eid_steps::HASH_SHA384;

/// Returns `[registry root, commitment]` through the databus, to the DSC
/// kernel that folds this proof.
fn main(
    root: Field,
    salt: Field,
    w: Witness<1600, 96>,
    r: [u8; 48],
    s: [u8; 48],
) -> return_data [Field; 2] {
    let f = check::<1600, 96, 4>(root, w, KeyKind { key_type: 2, curve: 16, bits: 384 });
    let mut x: [u8; 48] = [0; 48];
    let mut y: [u8; 48] = [0; 48];
    for i in 0..48 {
        x[i] = w.csca_key[i];
        y[i] = w.csca_key[48 + i];
    }
    verify_bp384::<48>(x, y, r, s, sha384_var(w.tbs, f.len));
    [root, commitment(salt, w.header.country, HASH_SHA384, w.tbs, f.len)]
}
