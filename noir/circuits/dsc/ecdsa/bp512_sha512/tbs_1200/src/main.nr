//! DSC step · ECDSA · bp512 · SHA512 · TBSCertificate ≤ 1200 bytes.
//!
//! Generated by `eid-vectors circuits`; specification: docs/circuits/dsc.md.

use eid_ecdsa::verify_bp512;
use eid_hash::sha512_var;
use eid_steps::dsc::{check, commitment, KeyKind, Witness};
use eid_steps::HASH_SHA512;

/// Returns `[registry root, commitment, hash id]` through the databus, to the
/// DSC kernel that folds this proof.
fn main(
    root: Field,
    salt: Field,
    w: Witness<1200, 128>,
    r: [u8; 64],
    s: [u8; 64],
) -> return_data [Field; 3] {
    let f = check::<1200, 128, 5>(root, w, KeyKind { key_type: 2, curve: 18, bits: 512 });
    let mut x: [u8; 64] = [0; 64];
    let mut y: [u8; 64] = [0; 64];
    for i in 0..64 {
        x[i] = w.csca_key[i];
        y[i] = w.csca_key[64 + i];
    }
    verify_bp512::<64>(x, y, r, s, sha512_var(w.tbs, f.len));
    [root, commitment(salt, w.header.country, HASH_SHA512, w.tbs, f.len), HASH_SHA512 as Field]
}
