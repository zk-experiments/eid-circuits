//! DSC step · ECDSA · p256 · SHA1 · TBSCertificate ≤ 1000 bytes.
//!
//! Generated by `eid-vectors circuits`; specification: docs/circuits/dsc.md.

use eid_ecdsa::verify_p256;
use eid_hash::sha1_var;
use eid_steps::dsc::{check, commitment, KeyKind, Witness};
use eid_steps::HASH_SHA1;

/// Returns `[registry root, commitment]` through the databus, to the pipeline
/// kernel that folds this step (noir-zk).
fn main(
    root: Field,
    salt: Field,
    w: Witness<1000, 64>,
    r: [u8; 32],
    s: [u8; 32],
) -> return_data [Field; 2] {
    let f = check::<1000, 64, 3>(root, w, KeyKind { key_type: 2, curve: 3, bits: 256 });
    let mut x: [u8; 32] = [0; 32];
    let mut y: [u8; 32] = [0; 32];
    for i in 0..32 {
        x[i] = w.csca_key[i];
        y[i] = w.csca_key[32 + i];
    }
    verify_p256::<20>(x, y, r, s, sha1_var(w.tbs, f.len));
    [root, commitment(salt, w.header.country, HASH_SHA1, w.tbs, f.len)]
}
