//! DSC step · ECDSA · p384 · SHA256 · TBSCertificate ≤ 1000 bytes.
//!
//! Generated by `eid-vectors circuits`; specification: docs/circuits/dsc.md.

use eid_ecdsa::verify_p384;
use eid_hash::sha256_var;
use eid_steps::dsc::{check, commitment, KeyKind, Witness};
use eid_steps::HASH_SHA256;

/// Public: registry root. Returns `[commitment, hash id]`.
fn main(
    root: pub Field,
    salt: Field,
    w: Witness<1000, 96>,
    r: [u8; 48],
    s: [u8; 48],
) -> pub [Field; 2] {
    let f = check::<1000, 96, 4>(root, w, KeyKind { key_type: 2, curve: 4, bits: 384 });
    let mut x: [u8; 48] = [0; 48];
    let mut y: [u8; 48] = [0; 48];
    for i in 0..48 {
        x[i] = w.csca_key[i];
        y[i] = w.csca_key[48 + i];
    }
    verify_p384::<32>(x, y, r, s, sha256_var(w.tbs, f.len));
    [commitment(salt, w.header.country, HASH_SHA256, w.tbs, f.len), HASH_SHA256 as Field]
}
