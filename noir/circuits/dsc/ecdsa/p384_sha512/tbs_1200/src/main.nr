//! DSC step · ECDSA · p384 · SHA512 · TBSCertificate ≤ 1200 bytes.
//!
//! Generated by `eid-vectors circuits`; specification: docs/circuits/dsc.md.

use eid_ecdsa::verify_p384;
use eid_hash::sha512_var;
use eid_steps::dsc::{check, commitment, KeyKind, Witness};
use eid_steps::HASH_SHA512;

/// Returns `[registry root, commitment]` through the databus, to the DSC
/// kernel that folds this proof.
fn main(
    root: Field,
    salt: Field,
    w: Witness<1200, 96>,
    r: [u8; 48],
    s: [u8; 48],
) -> return_data [Field; 2] {
    let f = check::<1200, 96, 4>(root, w, KeyKind { key_type: 2, curve: 4, bits: 384 });
    let mut x: [u8; 48] = [0; 48];
    let mut y: [u8; 48] = [0; 48];
    for i in 0..48 {
        x[i] = w.csca_key[i];
        y[i] = w.csca_key[48 + i];
    }
    verify_p384::<64>(x, y, r, s, sha512_var(w.tbs, f.len));
    [root, commitment(salt, w.header.country, HASH_SHA512, w.tbs, f.len)]
}
