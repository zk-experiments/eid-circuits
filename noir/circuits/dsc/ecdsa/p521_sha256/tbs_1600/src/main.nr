//! DSC step · ECDSA · p521 · SHA256 · TBSCertificate ≤ 1600 bytes.
//!
//! Generated by `eid-vectors circuits`; specification: docs/circuits/dsc.md.

use eid_ecdsa::verify_p521;
use eid_hash::sha256_var;
use eid_steps::dsc::{check, commitment, KeyKind, Witness};
use eid_steps::HASH_SHA256;

/// Returns `[registry root, commitment]` through the databus, to the DSC
/// kernel that folds this proof.
fn main(
    root: Field,
    salt: Field,
    w: Witness<1600, 132>,
    r: [u8; 66],
    s: [u8; 66],
) -> return_data [Field; 2] {
    let f = check::<1600, 132, 5>(root, w, KeyKind { key_type: 2, curve: 5, bits: 521 });
    let mut x: [u8; 66] = [0; 66];
    let mut y: [u8; 66] = [0; 66];
    for i in 0..66 {
        x[i] = w.csca_key[i];
        y[i] = w.csca_key[66 + i];
    }
    verify_p521::<32>(x, y, r, s, sha256_var(w.tbs, f.len));
    [root, commitment(salt, w.header.country, HASH_SHA256, w.tbs, f.len)]
}
