//! DSC step · RSASSA-PKCS1-v1_5 · RSA-2048 · SHA512 · TBSCertificate ≤ 1200 bytes.
//!
//! Generated by `eid-vectors circuits`; specification: docs/circuits/dsc.md.

use eid_hash::sha512_var;
use eid_rsa::{DIGEST_INFO_SHA512, verify_pkcs1v15};
use eid_steps::dsc::{check, commitment, KeyKind, Witness};
use eid_steps::HASH_SHA512;

/// Public: registry root. Returns `[commitment, hash id]`.
fn main(
    root: pub Field,
    salt: Field,
    w: Witness<1200, 256>,
    redc: [u128; 18],
    signature: [u8; 256],
) -> pub [Field; 2] {
    let f = check::<1200, 256, 9>(root, w, KeyKind { key_type: 1, curve: 0, bits: 2048 });
    let digest = sha512_var(w.tbs, f.len);
    verify_pkcs1v15::<18, 2048, 17, 64, 19>(
        w.csca_key,
        redc,
        w.header.exponent,
        signature,
        digest,
        DIGEST_INFO_SHA512,
    );
    [commitment(salt, w.header.country, HASH_SHA512, w.tbs, f.len), HASH_SHA512 as Field]
}
