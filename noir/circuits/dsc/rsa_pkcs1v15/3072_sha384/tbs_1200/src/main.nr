//! DSC step · RSASSA-PKCS1-v1_5 · RSA-3072 · SHA384 · TBSCertificate ≤ 1200 bytes.
//!
//! Generated by `eid-vectors circuits`; specification: docs/circuits/dsc.md.

use eid_hash::sha384_var;
use eid_rsa::{DIGEST_INFO_SHA384, verify_pkcs1v15};
use eid_steps::dsc::{check, commitment, KeyKind, Witness};
use eid_steps::HASH_SHA384;

/// Public: registry root. Returns `[commitment, hash id]`.
fn main(
    root: pub Field,
    salt: Field,
    w: Witness<1200, 384>,
    redc: [u128; 26],
    signature: [u8; 384],
) -> pub [Field; 2] {
    let f = check::<1200, 384, 13>(root, w, KeyKind { key_type: 1, curve: 0, bits: 3072 });
    let digest = sha384_var(w.tbs, f.len);
    verify_pkcs1v15::<26, 3072, 17, 48, 19>(
        w.csca_key,
        redc,
        w.header.exponent,
        signature,
        digest,
        DIGEST_INFO_SHA384,
    );
    [commitment(salt, w.header.country, HASH_SHA384, w.tbs, f.len), HASH_SHA384 as Field]
}
