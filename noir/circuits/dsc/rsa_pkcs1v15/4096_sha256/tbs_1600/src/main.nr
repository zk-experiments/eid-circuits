//! DSC step · RSASSA-PKCS1-v1_5 · RSA-4096 · SHA256 · TBSCertificate ≤ 1600 bytes.
//!
//! Generated by `eid-vectors circuits`; specification: docs/circuits/dsc.md.

use eid_hash::sha256_var;
use eid_rsa::{DIGEST_INFO_SHA256, verify_pkcs1v15};
use eid_steps::dsc::{check, commitment, KeyKind, Witness};
use eid_steps::HASH_SHA256;

/// Public: registry root. Returns `[commitment, hash id]`.
fn main(
    root: pub Field,
    salt: Field,
    w: Witness<1600, 512>,
    redc: [u128; 35],
    signature: [u8; 512],
) -> pub [Field; 2] {
    let f = check::<1600, 512, 17>(root, w, KeyKind { key_type: 1, curve: 0, bits: 4096 });
    let digest = sha256_var(w.tbs, f.len);
    verify_pkcs1v15::<35, 4096, 17, 32, 19>(
        w.csca_key,
        redc,
        w.header.exponent,
        signature,
        digest,
        DIGEST_INFO_SHA256,
    );
    [commitment(salt, w.header.country, HASH_SHA256, w.tbs, f.len), HASH_SHA256 as Field]
}
