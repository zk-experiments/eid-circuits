//! DSC step · RSASSA-PKCS1-v1_5 · RSA-4096 · SHA256 · TBSCertificate ≤ 700 bytes.
//!
//! Generated by `eid-vectors circuits`; specification: docs/circuits/dsc.md.

use eid_hash::sha256_var;
use eid_rsa::{DIGEST_INFO_SHA256, verify_pkcs1v15};
use eid_steps::dsc::{check, commitment, KeyKind, Witness};
use eid_steps::HASH_SHA256;

/// Returns `[registry root, commitment]` through the databus, to the DSC
/// kernel that folds this proof.
fn main(
    root: Field,
    salt: Field,
    w: Witness<700, 512>,
    redc: [u128; 35],
    signature: [u8; 512],
) -> return_data [Field; 2] {
    let f = check::<700, 512, 17>(root, w, KeyKind { key_type: 1, curve: 0, bits: 4096 });
    let digest = sha256_var(w.tbs, f.len);
    verify_pkcs1v15::<35, 4096, 17, 32, 19>(
        w.csca_key,
        redc,
        w.header.exponent,
        signature,
        digest,
        DIGEST_INFO_SHA256,
    );
    [root, commitment(salt, w.header.country, HASH_SHA256, w.tbs, f.len)]
}
