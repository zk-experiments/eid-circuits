//! DSC step · RSASSA-PKCS1-v1_5 · RSA-4096 · SHA384 · TBSCertificate ≤ 1200 bytes.
//!
//! Generated by `eid-vectors circuits`; specification: docs/circuits/dsc.md.

use eid_hash::sha384_var;
use eid_rsa::{DIGEST_INFO_SHA384, verify_pkcs1v15};
use eid_steps::dsc::{check, commitment, KeyKind, Witness};
use eid_steps::HASH_SHA384;

/// Returns `[registry root, commitment, hash id]` through the databus, to the
/// DSC kernel that folds this proof.
fn main(
    root: Field,
    salt: Field,
    w: Witness<1200, 512>,
    redc: [u128; 35],
    signature: [u8; 512],
) -> return_data [Field; 3] {
    let f = check::<1200, 512, 17>(root, w, KeyKind { key_type: 1, curve: 0, bits: 4096 });
    let digest = sha384_var(w.tbs, f.len);
    verify_pkcs1v15::<35, 4096, 17, 48, 19>(
        w.csca_key,
        redc,
        w.header.exponent,
        signature,
        digest,
        DIGEST_INFO_SHA384,
    );
    [root, commitment(salt, w.header.country, HASH_SHA384, w.tbs, f.len), HASH_SHA384 as Field]
}
