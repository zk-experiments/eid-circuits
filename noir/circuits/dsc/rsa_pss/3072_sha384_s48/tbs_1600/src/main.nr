//! DSC step · RSASSA-PSS · RSA-3072 · SHA384 with MGF1 · 48-byte salt · TBSCertificate ≤ 1600 bytes.
//!
//! Generated by `eid-vectors circuits`; specification: docs/circuits/dsc.md.

use eid_hash::{Sha384, sha384_var};
use eid_rsa::verify_pss;
use eid_steps::dsc::{check, commitment, KeyKind, Witness};
use eid_steps::HASH_SHA384;

/// Returns `[registry root, commitment, hash id]` through the databus, to the
/// DSC kernel that folds this proof.
fn main(
    root: Field,
    salt: Field,
    w: Witness<1600, 384>,
    redc: [u128; 26],
    signature: [u8; 384],
) -> return_data [Field; 3] {
    let f = check::<1600, 384, 13>(root, w, KeyKind { key_type: 1, curve: 0, bits: 3072 });
    let digest = sha384_var(w.tbs, f.len);
    verify_pss::<Sha384, 26, 3072, 17, 48, 48>(
        w.csca_key,
        redc,
        w.header.exponent,
        signature,
        digest,
    );
    [root, commitment(salt, w.header.country, HASH_SHA384, w.tbs, f.len), HASH_SHA384 as Field]
}
