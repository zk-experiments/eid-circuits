//! DSC step · RSASSA-PSS · RSA-4096 · SHA256 with MGF1 · 32-byte salt · TBSCertificate ≤ 1200 bytes.
//!
//! Generated by `eid-vectors circuits`; specification: docs/circuits/dsc.md.

use eid_hash::{Sha256, sha256_var};
use eid_rsa::verify_pss;
use eid_steps::dsc::{check, commitment, KeyKind, Witness};
use eid_steps::HASH_SHA256;

/// Returns `[registry root, commitment]` through the databus, to the pipeline
/// kernel that folds this step (noir-zk).
fn main(
    root: Field,
    salt: Field,
    w: Witness<1200, 512>,
    redc: [u128; 35],
    signature: [u8; 512],
) -> return_data [Field; 2] {
    let f = check::<1200, 512, 17>(root, w, KeyKind { key_type: 1, curve: 0, bits: 4096 });
    let digest = sha256_var(w.tbs, f.len);
    verify_pss::<Sha256, 35, 4096, 17, 32, 32>(
        w.csca_key,
        redc,
        w.header.exponent,
        signature,
        digest,
    );
    [root, commitment(salt, w.header.country, HASH_SHA256, w.tbs, f.len)]
}
