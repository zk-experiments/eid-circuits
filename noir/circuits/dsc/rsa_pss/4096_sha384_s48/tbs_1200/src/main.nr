//! DSC step · RSASSA-PSS · RSA-4096 · SHA384 with MGF1 · 48-byte salt · TBSCertificate ≤ 1200 bytes.
//!
//! Generated by `eid-vectors circuits`; specification: docs/circuits/dsc.md.

use eid_hash::{Sha384, sha384_var};
use eid_rsa::verify_pss;
use eid_steps::dsc::{check, commitment, KeyKind, Witness};
use eid_steps::HASH_SHA384;

/// Returns `[registry root, commitment]` through the databus, to the DSC
/// kernel that folds this proof.
fn main(
    root: Field,
    salt: Field,
    w: Witness<1200, 512>,
    redc: [u128; 35],
    signature: [u8; 512],
) -> return_data [Field; 2] {
    let f = check::<1200, 512, 17>(root, w, KeyKind { key_type: 1, curve: 0, bits: 4096 });
    let digest = sha384_var(w.tbs, f.len);
    verify_pss::<Sha384, 35, 4096, 17, 48, 48>(
        w.csca_key,
        redc,
        w.header.exponent,
        signature,
        digest,
    );
    [root, commitment(salt, w.header.country, HASH_SHA384, w.tbs, f.len)]
}
