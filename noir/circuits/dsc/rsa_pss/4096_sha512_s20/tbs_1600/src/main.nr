//! DSC step · RSASSA-PSS · RSA-4096 · SHA512 with MGF1 · 20-byte salt · TBSCertificate ≤ 1600 bytes.
//!
//! Generated by `eid-vectors circuits`; specification: docs/circuits/dsc.md.

use eid_hash::{Sha512, sha512_var};
use eid_rsa::verify_pss;
use eid_steps::dsc::{check, commitment, KeyKind, Witness};
use eid_steps::HASH_SHA512;

/// Returns `[registry root, commitment, hash id]` through the databus, to the
/// DSC kernel that folds this proof.
fn main(
    root: Field,
    salt: Field,
    w: Witness<1600, 512>,
    redc: [u128; 35],
    signature: [u8; 512],
) -> return_data [Field; 3] {
    let f = check::<1600, 512, 17>(root, w, KeyKind { key_type: 1, curve: 0, bits: 4096 });
    let digest = sha512_var(w.tbs, f.len);
    verify_pss::<Sha512, 35, 4096, 17, 64, 20>(
        w.csca_key,
        redc,
        w.header.exponent,
        signature,
        digest,
    );
    [root, commitment(salt, w.header.country, HASH_SHA512, w.tbs, f.len), HASH_SHA512 as Field]
}
