//! Envelope step · eContent SHA-1 · data groups SHA-256 · eContent ≤ 1024 bytes.
//!
//! Generated by `eid-vectors circuits`; specification: docs/circuits/envelope.md.

use eid_hash::{sha1_var, sha256_var};
use eid_steps::envelope::{
    assert_hash_at, assert_message_digest, check, flatten, OID_SHA256, outputs, Witness,
};
use eid_steps::{HASH_SHA1, HASH_SHA256};
use std::embedded_curve_ops::EmbeddedCurvePoint;

/// Takes the proof date (unix seconds), the context the envelope is bound to
/// (e.g. the transfer), the nullifier scope (0 for none) and the viewer keys
/// (`(0, 0)` leaves a slot empty), and returns them with step B's commitment,
/// the hash ids, the envelope and the nullifier through the databus
/// (`envelope::flatten`), to the envelope kernel.
fn main(
    date: u64,
    context: Field,
    scope: Field,
    viewers: [EmbeddedCurvePoint; 4],
    w: Witness<1024>,
) -> return_data [Field; 27] {
    let p = check::<1024, 11, 32>(date, w, OID_SHA256);
    assert_message_digest(w, sha1_var(w.econtent, p.lds.len));
    assert_hash_at(w.econtent, p.lds.dg1_hash_at, sha256_var(w.dg1, p.dg1.len));
    flatten(
        date,
        context,
        scope,
        viewers,
        outputs(viewers, context, scope, w, p, HASH_SHA1, HASH_SHA256),
    )
}
