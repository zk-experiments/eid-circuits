//! Envelope step · eContent SHA-1 · data groups SHA-512 · eContent ≤ 1024 bytes.
//!
//! Generated by `eid-vectors circuits`; specification: docs/circuits/envelope.md.

use eid_hash::{sha1_var, sha512_var};
use eid_steps::envelope::{
    assert_hash_at, assert_message_digest, check, OID_SHA512, Outputs, outputs, Witness,
};
use eid_steps::{HASH_SHA1, HASH_SHA512};
use std::embedded_curve_ops::EmbeddedCurvePoint;

/// Public: proof date (unix seconds) and viewer keys (`(0, 0)` leaves a slot
/// empty). Returns step B's commitment, the hash ids and the envelope.
fn main(date: pub u64, viewers: pub [EmbeddedCurvePoint; 4], w: Witness<1024>) -> pub Outputs {
    let p = check::<1024, 11, 64>(date, w, OID_SHA512);
    assert_message_digest(w, sha1_var(w.econtent, p.lds.len));
    assert_hash_at(w.econtent, p.lds.dg1_hash_at, sha512_var(w.dg1, p.dg1.len));
    let dg11 = sha512_var(w.dg11, p.dg11_len);
    if w.has_dg11 {
        assert_hash_at(w.econtent, p.lds.dg11_hash_at, dg11);
    }
    outputs(viewers, w, p, HASH_SHA1, HASH_SHA512)
}
