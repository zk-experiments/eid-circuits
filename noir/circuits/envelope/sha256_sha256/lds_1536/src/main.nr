//! Envelope step · eContent SHA-256 · data groups SHA-256 · eContent ≤ 1536 bytes.
//!
//! Generated by `eid-vectors circuits`; specification: docs/circuits/envelope.md.

use eid_hash::sha256_var;
use eid_steps::envelope::{
    assert_hash_at, assert_message_digest, check, flatten, OID_SHA256, outputs, Witness,
};
use std::embedded_curve_ops::EmbeddedCurvePoint;

/// Takes the proof date (unix seconds), the context the envelope is bound to
/// (e.g. the transfer), the nullifier scope (0 for none) and the viewer key
/// (fresh per transfer, never `(0, 0)`), and returns them with step B's
/// commitment, the envelope and the nullifier through the databus
/// (`envelope::flatten`), to the envelope kernel.
fn main(
    date: u64,
    context: Field,
    scope: Field,
    viewers: [EmbeddedCurvePoint; 1],
    w: Witness<1536>,
) -> return_data [Field; 16] {
    let p = check::<1536, 11, 32>(date, w, OID_SHA256);
    assert_message_digest(w, sha256_var(w.econtent, p.lds.len));
    assert_hash_at(w.econtent, p.lds.dg1_hash_at, sha256_var(w.dg1, p.dg1.len));
    flatten(
        date,
        context,
        scope,
        viewers,
        outputs(viewers, context, scope, w, p),
    )
}
