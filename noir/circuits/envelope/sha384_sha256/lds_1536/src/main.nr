//! Envelope step · eContent SHA-384 · data groups SHA-256 · eContent ≤ 1536 bytes.
//!
//! Generated by `eid-vectors circuits`; specification: docs/circuits/envelope.md.

use eid_hash::{sha256_var, sha384_var};
use eid_steps::envelope::{
    assert_hash_at, assert_message_digest, check, OID_SHA256, Outputs, outputs, Witness,
};
use eid_steps::{HASH_SHA256, HASH_SHA384};
use std::embedded_curve_ops::EmbeddedCurvePoint;

/// Public: proof date (unix seconds), the context the envelope is bound to
/// (e.g. the transfer), and viewer keys (`(0, 0)` leaves a slot empty).
/// Returns step B's commitment, the hash ids and the envelope.
fn main(
    date: pub u64,
    context: pub Field,
    viewers: pub [EmbeddedCurvePoint; 4],
    w: Witness<1536>,
) -> pub Outputs {
    let p = check::<1536, 11, 32>(date, w, OID_SHA256);
    assert_message_digest(w, sha384_var(w.econtent, p.lds.len));
    assert_hash_at(w.econtent, p.lds.dg1_hash_at, sha256_var(w.dg1, p.dg1.len));
    let dg11 = sha256_var(w.dg11, p.dg11_len);
    if w.has_dg11 {
        assert_hash_at(w.econtent, p.lds.dg11_hash_at, dg11);
    }
    outputs(viewers, context, w, p, HASH_SHA384, HASH_SHA256)
}
