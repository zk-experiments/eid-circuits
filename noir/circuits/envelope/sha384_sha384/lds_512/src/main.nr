//! Envelope step · eContent SHA-384 · data groups SHA-384 · eContent ≤ 512 bytes.
//!
//! Generated by `eid-vectors circuits`; specification: docs/circuits/envelope.md.

use eid_hash::sha384_var;
use eid_steps::envelope::{
    assert_hash_at, assert_message_digest, check, flatten, OID_SHA384, outputs, Witness,
};
use eid_steps::HASH_SHA384;
use std::embedded_curve_ops::EmbeddedCurvePoint;

/// Takes the proof date (unix seconds), the context the envelope is bound to
/// (e.g. the transfer) and the viewer keys (`(0, 0)` leaves a slot empty), and
/// returns them with step B's commitment, the hash ids and the envelope
/// through the databus (`envelope::flatten`), to the envelope kernel.
fn main(
    date: u64,
    context: Field,
    viewers: [EmbeddedCurvePoint; 4],
    w: Witness<512>,
) -> return_data [Field; 25] {
    let p = check::<512, 11, 48>(date, w, OID_SHA384);
    assert_message_digest(w, sha384_var(w.econtent, p.lds.len));
    assert_hash_at(w.econtent, p.lds.dg1_hash_at, sha384_var(w.dg1, p.dg1.len));
    flatten(
        date,
        context,
        viewers,
        outputs(viewers, context, w, p, HASH_SHA384, HASH_SHA384),
    )
}
