//! Envelope step · eContent SHA-384 · data groups SHA-512 · eContent ≤ 512 bytes.
//!
//! Generated by `eid-vectors circuits`; specification: docs/circuits/envelope.md.

use eid_hash::{sha384_var, sha512_var};
use eid_steps::envelope::{
    assert_hash_at, assert_message_digest, check, flatten, OID_SHA512, outputs, Witness,
};
use eid_steps::{HASH_SHA384, HASH_SHA512};
use std::embedded_curve_ops::EmbeddedCurvePoint;

/// Takes the proof date (unix seconds), the context the envelope is bound to
/// (e.g. the transfer), the nullifier scope (0 for none) and the viewer keys
/// (`(0, 0)` leaves a slot empty), and returns them with step B's commitment,
/// the hash ids, the envelope and the nullifier through the databus
/// (`envelope::flatten`), to the envelope kernel.
fn main(
    date: u64,
    context: Field,
    scope: Field,
    viewers: [EmbeddedCurvePoint; 4],
    w: Witness<512>,
) -> return_data [Field; 27] {
    let p = check::<512, 11, 64>(date, w, OID_SHA512);
    assert_message_digest(w, sha384_var(w.econtent, p.lds.len));
    assert_hash_at(w.econtent, p.lds.dg1_hash_at, sha512_var(w.dg1, p.dg1.len));
    flatten(
        date,
        context,
        scope,
        viewers,
        outputs(viewers, context, scope, w, p, HASH_SHA384, HASH_SHA512),
    )
}
