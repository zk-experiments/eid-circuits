//! SOD step · brainpoolP256r1 · ECDSA SHA-512 · DSC TBSCertificate ≤ 1000 bytes.
//!
//! Generated by `eid-vectors circuits`; specification: docs/circuits/sod.md.

use eid_der::{curves::BP256, spki_ec};
use eid_ecdsa::verify_bp256;
use eid_hash::sha512_var;
use eid_steps::{dsc, sod};

/// Returns `[DSC commitment, SOD commitment]` through the databus, to the
/// pipeline kernel (noir-zk), which checks the first equals the DSC step's.
fn main(
    dsc_salt: Field,
    dsc_hash_id: u8,
    country: [u8; 3],
    salt: Field,
    tbs: [u8; 1000],
    attrs: [u8; 256],
    md_offset: u32,
    r: [u8; 32],
    s: [u8; 32],
) -> return_data [Field; 2] {
    let (f, a) = sod::parse(tbs, attrs, md_offset);
    let (x, y) = spki_ec(tbs, f.spki_offset, f.len, BP256);
    verify_bp256::<64>(x, y, r, s, sha512_var(attrs, a.len));
    [dsc::commitment(dsc_salt, country, dsc_hash_id, tbs, f.len), sod::commitment(salt, country, a)]
}
