//! SOD step · brainpoolP384r1 · ECDSA SHA-256 · DSC TBSCertificate ≤ 1600 bytes.
//!
//! Generated by `eid-vectors circuits`; specification: docs/circuits/sod.md.

use eid_der::{curves::BP384, spki_ec};
use eid_ecdsa::verify_bp384;
use eid_hash::sha256_var;
use eid_steps::{dsc, sod};

/// Returns `[DSC commitment, SOD commitment]` through the databus, to the SOD
/// kernel, which checks the first equals the DSC step's.
fn main(
    dsc_salt: Field,
    dsc_hash_id: u8,
    country: [u8; 3],
    salt: Field,
    tbs: [u8; 1600],
    attrs: [u8; 256],
    md_offset: u32,
    r: [u8; 48],
    s: [u8; 48],
) -> return_data [Field; 2] {
    let (f, a) = sod::parse(tbs, attrs, md_offset);
    let (x, y) = spki_ec(tbs, f.spki_offset, f.len, BP384);
    verify_bp384::<32>(x, y, r, s, sha256_var(attrs, a.len));
    [dsc::commitment(dsc_salt, country, dsc_hash_id, tbs, f.len), sod::commitment(salt, country, a)]
}
