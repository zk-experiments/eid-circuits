//! SOD step · brainpoolP512r1 · ECDSA SHA-512 · DSC TBSCertificate ≤ 1600 bytes.
//!
//! Generated by `eid-vectors circuits`; specification: docs/circuits/sod.md.

use eid_der::{curves::BP512, spki_ec};
use eid_ecdsa::verify_bp512;
use eid_hash::sha512_var;
use eid_steps::{dsc, sod};
use eid_steps::HASH_SHA512;

/// Returns `[DSC commitment, SOD commitment, hash id]`. The first must equal
/// the DSC step's output.
fn main(
    dsc_salt: Field,
    dsc_hash_id: u8,
    country: [u8; 3],
    salt: Field,
    tbs: [u8; 1600],
    attrs: [u8; 256],
    md_offset: u32,
    r: [u8; 64],
    s: [u8; 64],
) -> pub [Field; 3] {
    let (f, a) = sod::parse(tbs, attrs, md_offset);
    let (x, y) = spki_ec(tbs, f.spki_offset, f.len, BP512);
    verify_bp512::<64>(x, y, r, s, sha512_var(attrs, a.len));
    [
        dsc::commitment(dsc_salt, country, dsc_hash_id, tbs, f.len),
        sod::commitment(salt, country, a),
        HASH_SHA512 as Field,
    ]
}
