//! SOD step · P-521 · ECDSA SHA-256 · DSC TBSCertificate ≤ 1200 bytes.
//!
//! Generated by `eid-vectors circuits`; specification: docs/circuits/sod.md.

use eid_der::{curves::P521, spki_ec};
use eid_ecdsa::verify_p521;
use eid_hash::sha256_var;
use eid_steps::{dsc, sod};
use eid_steps::HASH_SHA256;

/// Returns `[DSC commitment, SOD commitment, hash id]` through the databus, to
/// the SOD kernel, which checks the first equals the DSC step's.
fn main(
    dsc_salt: Field,
    dsc_hash_id: u8,
    country: [u8; 3],
    salt: Field,
    tbs: [u8; 1200],
    attrs: [u8; 256],
    md_offset: u32,
    r: [u8; 66],
    s: [u8; 66],
) -> return_data [Field; 3] {
    let (f, a) = sod::parse(tbs, attrs, md_offset);
    let (x, y) = spki_ec(tbs, f.spki_offset, f.len, P521);
    verify_p521::<32>(x, y, r, s, sha256_var(attrs, a.len));
    [
        dsc::commitment(dsc_salt, country, dsc_hash_id, tbs, f.len),
        sod::commitment(salt, country, a),
        HASH_SHA256 as Field,
    ]
}
