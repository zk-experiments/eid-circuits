//! SOD step · RSA-4096 · PKCS#1 v1.5 SHA-1 · DSC TBSCertificate ≤ 1600 bytes.
//!
//! Generated by `eid-vectors circuits`; specification: docs/circuits/sod.md.

use eid_der::spki_rsa;
use eid_hash::sha1_var;
use eid_rsa::{DIGEST_INFO_SHA1, verify_pkcs1v15};
use eid_steps::{dsc, sod};
use eid_steps::HASH_SHA1;

/// Returns `[DSC commitment, SOD commitment, hash id]` through the databus, to
/// the SOD kernel, which checks the first equals the DSC step's.
fn main(
    dsc_salt: Field,
    dsc_hash_id: u8,
    country: [u8; 3],
    salt: Field,
    tbs: [u8; 1600],
    attrs: [u8; 256],
    md_offset: u32,
    redc: [u128; 35],
    signature: [u8; 512],
) -> return_data [Field; 3] {
    let (f, a) = sod::parse(tbs, attrs, md_offset);
    let (modulus, exponent) = spki_rsa::<1600, 512>(tbs, f.spki_offset, f.len);
    let digest = sha1_var(attrs, a.len);
    verify_pkcs1v15::<35, 4096, 17, 20, 15>(
        modulus,
        redc,
        exponent,
        signature,
        digest,
        DIGEST_INFO_SHA1,
    );
    [
        dsc::commitment(dsc_salt, country, dsc_hash_id, tbs, f.len),
        sod::commitment(salt, country, a),
        HASH_SHA1 as Field,
    ]
}
