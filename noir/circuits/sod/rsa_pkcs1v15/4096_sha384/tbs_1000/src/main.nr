//! SOD step · RSA-4096 · PKCS#1 v1.5 SHA-384 · DSC TBSCertificate ≤ 1000 bytes.
//!
//! Generated by `eid-vectors circuits`; specification: docs/circuits/sod.md.

use eid_der::spki_rsa;
use eid_hash::sha384_var;
use eid_rsa::{DIGEST_INFO_SHA384, verify_pkcs1v15};
use eid_steps::{dsc, sod};

/// Returns `[DSC commitment, SOD commitment]` through the databus, to the
/// pipeline kernel (noir-zk), which checks the first equals the DSC step's.
fn main(
    dsc_salt: Field,
    dsc_hash_id: u8,
    country: [u8; 3],
    salt: Field,
    tbs: [u8; 1000],
    attrs: [u8; 256],
    md_offset: u32,
    redc: [u128; 35],
    signature: [u8; 512],
) -> return_data [Field; 2] {
    let (f, a) = sod::parse(tbs, attrs, md_offset);
    let (modulus, exponent) = spki_rsa::<1000, 512>(tbs, f.spki_offset, f.len);
    let digest = sha384_var(attrs, a.len);
    verify_pkcs1v15::<35, 4096, 17, 48, 19>(
        modulus,
        redc,
        exponent,
        signature,
        digest,
        DIGEST_INFO_SHA384,
    );
    [dsc::commitment(dsc_salt, country, dsc_hash_id, tbs, f.len), sod::commitment(salt, country, a)]
}
