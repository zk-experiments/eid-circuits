//! SOD step · RSA-6144 · PKCS#1 v1.5 SHA-256 · DSC TBSCertificate ≤ 1600 bytes.
//!
//! Generated by `eid-vectors circuits`; specification: docs/circuits/sod.md.

use eid_der::spki_rsa;
use eid_hash::sha256_var;
use eid_rsa::{DIGEST_INFO_SHA256, verify_pkcs1v15};
use eid_steps::{dsc, sod};
use eid_steps::HASH_SHA256;

/// Returns `[DSC commitment, SOD commitment, hash id]`. The first must equal
/// the DSC step's output.
fn main(
    dsc_salt: Field,
    dsc_hash_id: u8,
    country: [u8; 3],
    salt: Field,
    tbs: [u8; 1600],
    attrs: [u8; 256],
    md_offset: u32,
    redc: [u128; 52],
    signature: [u8; 768],
) -> pub [Field; 3] {
    let (f, a) = sod::parse(tbs, attrs, md_offset);
    let (modulus, exponent) = spki_rsa::<1600, 768>(tbs, f.spki_offset, f.len);
    let digest = sha256_var(attrs, a.len);
    verify_pkcs1v15::<52, 6144, 17, 32, 19>(
        modulus,
        redc,
        exponent,
        signature,
        digest,
        DIGEST_INFO_SHA256,
    );
    [
        dsc::commitment(dsc_salt, country, dsc_hash_id, tbs, f.len),
        sod::commitment(salt, country, a),
        HASH_SHA256 as Field,
    ]
}
