//! SOD step · RSA-4096 · PSS SHA-384 salt 48 · DSC TBSCertificate ≤ 700 bytes.
//!
//! Generated by `eid-vectors circuits`; specification: docs/circuits/sod.md.

use eid_der::spki_rsa;
use eid_hash::{Sha384, sha384_var};
use eid_rsa::verify_pss;
use eid_steps::{dsc, sod};
use eid_steps::HASH_SHA384;

/// Returns `[DSC commitment, SOD commitment, hash id]`. The first must equal
/// the DSC step's output.
fn main(
    dsc_salt: Field,
    dsc_hash_id: u8,
    country: [u8; 3],
    salt: Field,
    tbs: [u8; 700],
    attrs: [u8; 256],
    md_offset: u32,
    redc: [u128; 35],
    signature: [u8; 512],
) -> pub [Field; 3] {
    let (f, a) = sod::parse(tbs, attrs, md_offset);
    let (modulus, exponent) = spki_rsa::<700, 512>(tbs, f.spki_offset, f.len);
    let digest = sha384_var(attrs, a.len);
    verify_pss::<Sha384, 35, 4096, 17, 48, 48>(modulus, redc, exponent, signature, digest);
    [
        dsc::commitment(dsc_salt, country, dsc_hash_id, tbs, f.len),
        sod::commitment(salt, country, a),
        HASH_SHA384 as Field,
    ]
}
