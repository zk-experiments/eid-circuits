//! SOD step · RSA-4096 · PSS SHA-512 salt 64 · DSC TBSCertificate ≤ 1200 bytes.
//!
//! Generated by `eid-vectors circuits`; specification: docs/circuits/sod.md.

use eid_der::spki_rsa;
use eid_hash::{Sha512, sha512_var};
use eid_rsa::verify_pss;
use eid_steps::{dsc, sod};
use eid_steps::HASH_SHA512;

/// Returns `[DSC commitment, SOD commitment, hash id]` through the databus, to
/// the SOD kernel, which checks the first equals the DSC step's.
fn main(
    dsc_salt: Field,
    dsc_hash_id: u8,
    country: [u8; 3],
    salt: Field,
    tbs: [u8; 1200],
    attrs: [u8; 256],
    md_offset: u32,
    redc: [u128; 35],
    signature: [u8; 512],
) -> return_data [Field; 3] {
    let (f, a) = sod::parse(tbs, attrs, md_offset);
    let (modulus, exponent) = spki_rsa::<1200, 512>(tbs, f.spki_offset, f.len);
    let digest = sha512_var(attrs, a.len);
    verify_pss::<Sha512, 35, 4096, 17, 64, 64>(modulus, redc, exponent, signature, digest);
    [
        dsc::commitment(dsc_salt, country, dsc_hash_id, tbs, f.len),
        sod::commitment(salt, country, a),
        HASH_SHA512 as Field,
    ]
}
