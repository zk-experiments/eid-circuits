//! ECDSA verification (SEC 1 §4.1.4 / FIPS 186-5 §6.4.2) for eMRTD PKIs on
//! P-256, P-384, P-521 and brainpoolP256r1/384r1/512r1, over
//! `noir-lang/noir_bigcurve` (non-native curve arithmetic) and
//! `noir-lang/noir-bignum` (non-native fields).
//!
//! P-256 and P-384 use noir_bigcurve's curves; the others are generated by
//! `eid-vectors curves` into the vendored noir_bigcurve (`curves/eid_*.nr`). Specification and review notes: README.md.

mod tests;
mod vectors;

use bignum::{BigNum, Secp256r1_Fq, Secp256r1_Fr, Secp384r1_Fq, Secp384r1_Fr};
use noir_bigcurve::{BigCurve, ScalarField};
use noir_bigcurve::curves::eid_bp256::{BP256_Fq, BP256_Fr, BP256_SCALAR_SLICES, BrainpoolP256r1};
use noir_bigcurve::curves::eid_bp384::{BP384_Fq, BP384_Fr, BP384_SCALAR_SLICES, BrainpoolP384r1};
use noir_bigcurve::curves::eid_bp512::{BP512_Fq, BP512_Fr, BP512_SCALAR_SLICES, BrainpoolP512r1};
use noir_bigcurve::curves::eid_p521::{P521, P521_Fq, P521_Fr, P521_SCALAR_SLICES};
use noir_bigcurve::curves::secp256r1::{Secp256r1, SECP256r1_SCALAR_SLICES};
use noir_bigcurve::curves::secp384r1::{Secp384r1, SECP384r1_SCALAR_SLICES};

/// Core check shared by every curve. Asserts that `q = (qx, qy)` is a finite
/// point on the curve, that `r` and `s` are in `[1, n − 1]`, and returns
/// `R = (e·s⁻¹)·G + (r·s⁻¹)·Q`, which must not be the point at infinity.
/// The caller compares `R.x mod n` with `r` (the byte sizes of the two fields
/// are only known per curve).
///
/// `e` is the digest truncated to the bit length of `n` (see
/// `digest_to_scalar_bytes`); it may be at least `n`, which the scalar field
/// arithmetic handles.
pub fn verify_core<C, Fq, Fr, let S: u32>(qx: Fq, qy: Fq, r: Fr, s: Fr, e: Fr) -> Fq
where
    C: BigCurve<Fq>,
    Fq: BigNum,
    Fr: BigNum,
{
    qx.validate_in_field();
    qy.validate_in_field();
    let q = C::from_coordinates(qx, qy, false);
    q.validate_on_curve();

    // validate_in_field proves value ≤ n; assert_is_not_zero rules out 0 and n.
    r.validate_in_field();
    s.validate_in_field();
    r.assert_is_not_zero();
    s.assert_is_not_zero();

    // Constrained division in the prime scalar field (checks u · s = e).
    let u1 = e / s;
    let u2 = r / s;
    let big_r = C::evaluate_linear_expression(
        [C::one(), q],
        [ScalarField::<S>::from_bignum(u1), ScalarField::<S>::from_bignum(u2)],
        [],
    );
    assert(!big_r.is_infinity(), "ECDSA R is the point at infinity");
    let x = big_r.x();
    x.validate_in_field();
    x
}

/// `bits2int` for an `NB`-byte scalar field whose order has `8·NB` bits (or,
/// for P-521, fewer than `8·NB` but at least `8·D`): the leftmost `NB` digest
/// bytes, right-aligned when the digest is shorter.
pub fn digest_to_scalar_bytes<let D: u32, let NB: u32>(digest: [u8; D]) -> [u8; NB] {
    let mut out: [u8; NB] = [0; NB];
    if D >= NB {
        for i in 0..NB {
            out[i] = digest[i];
        }
    } else {
        for i in 0..D {
            out[NB - D + i] = digest[i];
        }
    }
    out
}

/// ECDSA on P-256 (secp256r1) with a `D`-byte digest.
pub fn verify_p256<let D: u32>(
    x: [u8; 32],
    y: [u8; 32],
    r: [u8; 32],
    s: [u8; 32],
    digest: [u8; D],
) {
    let r = Secp256r1_Fr::from_be_bytes(r);
    let rx = verify_core::<Secp256r1, Secp256r1_Fq, Secp256r1_Fr, SECP256r1_SCALAR_SLICES>(
        Secp256r1_Fq::from_be_bytes(x),
        Secp256r1_Fq::from_be_bytes(y),
        r,
        Secp256r1_Fr::from_be_bytes(s),
        Secp256r1_Fr::from_be_bytes(digest_to_scalar_bytes(digest)),
    );
    assert_eq(Secp256r1_Fr::from_be_bytes(rx.to_be_bytes()), r, "ECDSA signature mismatch");
}

/// ECDSA on P-384 (secp384r1) with a `D`-byte digest.
pub fn verify_p384<let D: u32>(
    x: [u8; 48],
    y: [u8; 48],
    r: [u8; 48],
    s: [u8; 48],
    digest: [u8; D],
) {
    let r = Secp384r1_Fr::from_be_bytes(r);
    let rx = verify_core::<Secp384r1, Secp384r1_Fq, Secp384r1_Fr, SECP384r1_SCALAR_SLICES>(
        Secp384r1_Fq::from_be_bytes(x),
        Secp384r1_Fq::from_be_bytes(y),
        r,
        Secp384r1_Fr::from_be_bytes(s),
        Secp384r1_Fr::from_be_bytes(digest_to_scalar_bytes(digest)),
    );
    assert_eq(Secp384r1_Fr::from_be_bytes(rx.to_be_bytes()), r, "ECDSA signature mismatch");
}

/// ECDSA on P-521 (secp521r1) with a `D`-byte digest (`8·D ≤ 521`, so the
/// digest is used whole).
pub fn verify_p521<let D: u32>(
    x: [u8; 66],
    y: [u8; 66],
    r: [u8; 66],
    s: [u8; 66],
    digest: [u8; D],
) {
    assert(D <= 65, "P-521 digests are at most 65 bytes");
    let r = P521_Fr::from_be_bytes(r);
    let rx = verify_core::<P521, P521_Fq, P521_Fr, P521_SCALAR_SLICES>(
        P521_Fq::from_be_bytes(x),
        P521_Fq::from_be_bytes(y),
        r,
        P521_Fr::from_be_bytes(s),
        P521_Fr::from_be_bytes(digest_to_scalar_bytes(digest)),
    );
    assert_eq(P521_Fr::from_be_bytes(rx.to_be_bytes()), r, "ECDSA signature mismatch");
}

/// ECDSA on brainpoolP256r1 with a `D`-byte digest.
pub fn verify_bp256<let D: u32>(
    x: [u8; 32],
    y: [u8; 32],
    r: [u8; 32],
    s: [u8; 32],
    digest: [u8; D],
) {
    let r = BP256_Fr::from_be_bytes(r);
    let rx = verify_core::<BrainpoolP256r1, BP256_Fq, BP256_Fr, BP256_SCALAR_SLICES>(
        BP256_Fq::from_be_bytes(x),
        BP256_Fq::from_be_bytes(y),
        r,
        BP256_Fr::from_be_bytes(s),
        BP256_Fr::from_be_bytes(digest_to_scalar_bytes(digest)),
    );
    assert_eq(BP256_Fr::from_be_bytes(rx.to_be_bytes()), r, "ECDSA signature mismatch");
}

/// ECDSA on brainpoolP384r1 with a `D`-byte digest.
pub fn verify_bp384<let D: u32>(
    x: [u8; 48],
    y: [u8; 48],
    r: [u8; 48],
    s: [u8; 48],
    digest: [u8; D],
) {
    let r = BP384_Fr::from_be_bytes(r);
    let rx = verify_core::<BrainpoolP384r1, BP384_Fq, BP384_Fr, BP384_SCALAR_SLICES>(
        BP384_Fq::from_be_bytes(x),
        BP384_Fq::from_be_bytes(y),
        r,
        BP384_Fr::from_be_bytes(s),
        BP384_Fr::from_be_bytes(digest_to_scalar_bytes(digest)),
    );
    assert_eq(BP384_Fr::from_be_bytes(rx.to_be_bytes()), r, "ECDSA signature mismatch");
}

/// ECDSA on brainpoolP512r1 with a `D`-byte digest.
pub fn verify_bp512<let D: u32>(
    x: [u8; 64],
    y: [u8; 64],
    r: [u8; 64],
    s: [u8; 64],
    digest: [u8; D],
) {
    let r = BP512_Fr::from_be_bytes(r);
    let rx = verify_core::<BrainpoolP512r1, BP512_Fq, BP512_Fr, BP512_SCALAR_SLICES>(
        BP512_Fq::from_be_bytes(x),
        BP512_Fq::from_be_bytes(y),
        r,
        BP512_Fr::from_be_bytes(s),
        BP512_Fr::from_be_bytes(digest_to_scalar_bytes(digest)),
    );
    assert_eq(BP512_Fr::from_be_bytes(rx.to_be_bytes()), r, "ECDSA signature mismatch");
}
