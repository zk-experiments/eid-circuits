#[test]
fn ecdsa_sha384_bp384_ao() {
    verify_bp384::<48>(
        ECDSA_SHA384_BP384_AO_X,
        ECDSA_SHA384_BP384_AO_Y,
        ECDSA_SHA384_BP384_AO_R,
        ECDSA_SHA384_BP384_AO_S,
        sha384_var(ECDSA_SHA384_BP384_AO_TBS, 1094),
    );
}

