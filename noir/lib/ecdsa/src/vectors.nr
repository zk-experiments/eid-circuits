fn ecdsa_sha512_bp256_ba() {
    verify_bp256::<64>(
        ECDSA_SHA512_BP256_BA_X,
        ECDSA_SHA512_BP256_BA_Y,
        ECDSA_SHA512_BP256_BA_R,
        ECDSA_SHA512_BP256_BA_S,
        sha512_var(ECDSA_SHA512_BP256_BA_TBS, 880),
    );
}

