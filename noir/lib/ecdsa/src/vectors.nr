fn ecdsa_sha256_bp384_jo() {
    verify_bp384::<32>(
        ECDSA_SHA256_BP384_JO_X,
        ECDSA_SHA256_BP384_JO_Y,
        ECDSA_SHA256_BP384_JO_R,
        ECDSA_SHA256_BP384_JO_S,
        sha256_var(ECDSA_SHA256_BP384_JO_TBS, 969),
    );
}

