#[test]
fn ecdsa_sha512_bp512_br() {
    verify_bp512::<64>(
        ECDSA_SHA512_BP512_BR_X,
        ECDSA_SHA512_BP512_BR_Y,
        ECDSA_SHA512_BP512_BR_R,
        ECDSA_SHA512_BP512_BR_S,
        sha512_var(ECDSA_SHA512_BP512_BR_TBS, 1143),
    );
}
