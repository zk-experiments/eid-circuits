#[test]
fn eid_nullifier() {
    let digest = [
        0xec, 0x7e, 0x2e, 0xee, 0x26, 0x75, 0x85, 0x62, 0xc2, 0x79, 0x45, 0xc3, 0x03, 0x75, 0x0f,
        0xa1, 0x8e, 0x2c, 0x49, 0xb0, 0xe5, 0xa2, 0xea, 0xf9, 0x75, 0xbc, 0xc1, 0x7d, 0x48, 0x31,
        0xf1, 0x85, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00,
    ];
    assert_eq(
        nullifier(4242, digest, 32),
        162152989536147314201941387455620162006419115570722658448670984254153733565,
    );
    assert_eq(nullifier(0, digest, 32), 0);
}
