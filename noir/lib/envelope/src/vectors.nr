            x: 7602919717862440056544308983183088591363743861133240547804015883912961592200,
            y: 17978648322816306789783995461662044900113835306110407394667022058742648382954,
        },
    );
    assert_eq(
        env.wrapped,
        [
            3275353524638461703539790449581696386318954977489905578929792679620540282481,
            0,
            2342942735263730019352295163999317594862266126423709055156050290231290194769,
            0,
        ],
    );
    assert_eq(
        env.ciphertext,
        [
            6419116394743950605573975470302348216386416818410729163619649097285013186673,
            2948251718962296940442600736272970845275341589760780244811084209387770714063,
            2790694275446406168505141806033790766047795123478674273793414992472409561867,
            18714836990051472354296921479659280763176671636207811507584002480699809483196,
            12009840880052566259510545667731999801341476761853789563904005743881736823905,
            5345270537439976375816028806357179373882976555399148445447764887495142877897,
