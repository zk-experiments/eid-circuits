use crate::{nullifier, plaintext, seal};
use std::embedded_curve_ops::EmbeddedCurvePoint;

#[test]
fn dg1_envelope() {
    let viewers = [
        EmbeddedCurvePoint {
            x: 20851830316168396718310117844722626118035040694898289797213753523774255133295,
            y: 1349063346603533760882017251660848553995452554954439521589041229576092134020,
        },
        EmbeddedCurvePoint { x: 0, y: 0 },
        EmbeddedCurvePoint {
            x: 6095789661963140918323035309419624080559205910965587305873131847147633293934,
            y: 8233618030245881272624471007079912686436864284021771067386535153052262192863,
        },
        EmbeddedCurvePoint { x: 0, y: 0 },
    ];
    let p = plaintext(
        [
            0x61, 0x5b, 0x5f, 0x1f, 0x58, 0x50, 0x3c, 0x55, 0x54, 0x4f, 0x45, 0x52, 0x49, 0x4b,
            0x53, 0x53, 0x4f, 0x4e, 0x3c, 0x3c, 0x41, 0x4e, 0x4e, 0x41, 0x3c, 0x4d, 0x41, 0x52,
            0x49, 0x41, 0x3c, 0x3c, 0x3c, 0x3c, 0x3c, 0x3c, 0x3c, 0x3c, 0x3c, 0x3c, 0x3c, 0x3c,
            0x3c, 0x3c, 0x3c, 0x3c, 0x3c, 0x3c, 0x3c, 0x4c, 0x38, 0x39, 0x38, 0x39, 0x30, 0x32,
            0x43, 0x33, 0x36, 0x55, 0x54, 0x4f, 0x37, 0x34, 0x30, 0x38, 0x31, 0x32, 0x32, 0x46,
            0x33, 0x34, 0x30, 0x34, 0x31, 0x35, 0x39, 0x5a, 0x45, 0x31, 0x38, 0x34, 0x32, 0x32,
            0x36, 0x42, 0x3c, 0x3c, 0x3c, 0x3c, 0x3c, 0x31, 0x36, 0x00, 0x00,
        ],
        93,
    );
    let env = seal(viewers, 424242, 777777, 31337, p);
    assert_eq(
        env.ephemeral,
