fn pkcs1_sha384_3072_tj() {
    verify_pkcs1v15::<26, 3072, 17, 48, 19>(
        PKCS1_SHA384_3072_TJ_MODULUS,
        PKCS1_SHA384_3072_TJ_REDC,
        PKCS1_SHA384_3072_TJ_EXPONENT,
        PKCS1_SHA384_3072_TJ_SIGNATURE,
        sha384_var(PKCS1_SHA384_3072_TJ_TBS, 907),
        DIGEST_INFO_SHA384,
    );
}

