#[test]
fn pkcs1_sha256_4096_ad() {
    verify_pkcs1v15::<35, 4096, 17, 32, 19>(
        PKCS1_SHA256_4096_AD_MODULUS,
        PKCS1_SHA256_4096_AD_REDC,
        PKCS1_SHA256_4096_AD_EXPONENT,
        PKCS1_SHA256_4096_AD_SIGNATURE,
        sha256_var(PKCS1_SHA256_4096_AD_TBS, 811),
        DIGEST_INFO_SHA256,
    );
}

