#[test]
fn pkcs1_sha512_4096_au() {
    verify_pkcs1v15::<35, 4096, 17, 64, 19>(
        PKCS1_SHA512_4096_AU_MODULUS,
        PKCS1_SHA512_4096_AU_REDC,
        PKCS1_SHA512_4096_AU_EXPONENT,
        PKCS1_SHA512_4096_AU_SIGNATURE,
        sha512_var(PKCS1_SHA512_4096_AU_TBS, 1382),
        DIGEST_INFO_SHA512,
    );
}

