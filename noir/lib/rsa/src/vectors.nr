#[test]
fn pkcs1_sha384_4096_ad() {
    verify_pkcs1v15::<35, 4096, 17, 48, 19>(
        PKCS1_SHA384_4096_AD_MODULUS,
        PKCS1_SHA384_4096_AD_REDC,
        PKCS1_SHA384_4096_AD_EXPONENT,
        PKCS1_SHA384_4096_AD_SIGNATURE,
        sha384_var(PKCS1_SHA384_4096_AD_TBS, 1101),
        DIGEST_INFO_SHA384,
    );
}

