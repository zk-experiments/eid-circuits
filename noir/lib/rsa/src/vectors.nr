fn pkcs1_sha256_3072_ar() {
    verify_pkcs1v15::<26, 3072, 17, 32, 19>(
        PKCS1_SHA256_3072_AR_MODULUS,
        PKCS1_SHA256_3072_AR_REDC,
        PKCS1_SHA256_3072_AR_EXPONENT,
        PKCS1_SHA256_3072_AR_SIGNATURE,
        sha256_var(PKCS1_SHA256_3072_AR_TBS, 817),
        DIGEST_INFO_SHA256,
    );
}

