    ]);
    assert_eq(d.len, 77);
    assert_eq(d.issuing_state, [0x55, 0x54, 0x4f]);
    assert_eq(d.expires, EXPIRES);
}

#[test]
fn dg1_td3() {
    let d = parse_dg1([
        0x61, 0x5b, 0x5f, 0x1f, 0x58, 0x50, 0x3c, 0x55, 0x54, 0x4f, 0x45, 0x52, 0x49, 0x4b, 0x53,
        0x53, 0x4f, 0x4e, 0x3c, 0x3c, 0x41, 0x4e, 0x4e, 0x41, 0x3c, 0x4d, 0x41, 0x52, 0x49, 0x41,
        0x3c, 0x3c, 0x3c, 0x3c, 0x3c, 0x3c, 0x3c, 0x3c, 0x3c, 0x3c, 0x3c, 0x3c, 0x3c, 0x3c, 0x3c,
        0x3c, 0x3c, 0x3c, 0x3c, 0x4c, 0x38, 0x39, 0x38, 0x39, 0x30, 0x32, 0x43, 0x33, 0x36, 0x55,
        0x54, 0x4f, 0x37, 0x34, 0x30, 0x38, 0x31, 0x32, 0x32, 0x46, 0x33, 0x34, 0x30, 0x34, 0x31,
        0x35, 0x39, 0x5a, 0x45, 0x31, 0x38, 0x34, 0x32, 0x32, 0x36, 0x42, 0x3c, 0x3c, 0x3c, 0x3c,
        0x3c, 0x31, 0x36, 0x00, 0x00,
    ]);
    assert_eq(d.len, 93);
    assert_eq(d.issuing_state, [0x55, 0x54, 0x4f]);
