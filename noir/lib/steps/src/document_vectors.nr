#[test]
fn document_sha512_v1() {
    let p = check::<512, 11, 64>(DATE, sha512_v1(), OID_SHA512);
    assert_eq(p.lds.len, 253);
    assert_eq(p.dg1.len, 93);
    assert_eq(p.dg1.expires, EXPIRES);
}

#[test]
fn dg1_td1() {
    let d = parse_dg1([
        0x61, 0x5d, 0x5f, 0x1f, 0x5a, 0x49, 0x3c, 0x55, 0x54, 0x4f, 0x44, 0x32, 0x33, 0x31, 0x34,
        0x35, 0x38, 0x39, 0x30, 0x37, 0x3c, 0x3c, 0x3c, 0x3c, 0x3c, 0x3c, 0x3c, 0x3c, 0x3c, 0x3c,
        0x3c, 0x3c, 0x3c, 0x3c, 0x3c, 0x37, 0x34, 0x30, 0x38, 0x31, 0x32, 0x32, 0x46, 0x33, 0x34,
        0x30, 0x34, 0x31, 0x35, 0x39, 0x55, 0x54, 0x4f, 0x3c, 0x3c, 0x3c, 0x3c, 0x3c, 0x3c, 0x3c,
        0x3c, 0x3c, 0x3c, 0x3c, 0x32, 0x45, 0x52, 0x49, 0x4b, 0x53, 0x53, 0x4f, 0x4e, 0x3c, 0x3c,
        0x41, 0x4e, 0x4e, 0x41, 0x3c, 0x4d, 0x41, 0x52, 0x49, 0x41, 0x3c, 0x3c, 0x3c, 0x3c, 0x3c,
        0x3c, 0x3c, 0x3c, 0x3c, 0x3c,
    ]);
    assert_eq(d.len, 95);
    assert_eq(d.issuing_state, [0x55, 0x54, 0x4f]);
    assert_eq(d.expires, EXPIRES);
}

