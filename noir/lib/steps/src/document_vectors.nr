#[test]
fn document_sha256_v0() {
    let p = check::<512, 11, 32>(DATE, sha256_v0(), OID_SHA256);
    assert_eq(p.lds.len, 178);
    assert_eq(p.dg1.len, 93);
    assert_eq(p.dg1.expires, EXPIRES);
}

