#[test]
fn sod_pss_3072() {
    let (f, a) = parse(PSS_3072_TBS, PSS_3072_ATTRS, PSS_3072_MD_OFFSET);
    assert_eq(f.len, 558);
    assert_eq(a.len, 104);
    assert_eq(a.digest_len, 32);
    assert_eq(
        a.digest,
        [
            0xec, 0x7e, 0x2e, 0xee, 0x26, 0x75, 0x85, 0x62, 0xc2, 0x79, 0x45, 0xc3, 0x03, 0x75,
            0x0f, 0xa1, 0x8e, 0x2c, 0x49, 0xb0, 0xe5, 0xa2, 0xea, 0xf9, 0x75, 0xbc, 0xc1, 0x7d,
