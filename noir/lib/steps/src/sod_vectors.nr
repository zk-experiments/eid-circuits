#[test]
fn sod_bp256() {
    let (f, a) = parse(BP256_TBS, BP256_ATTRS, BP256_MD_OFFSET);
    assert_eq(f.len, 447);
    assert_eq(a.len, 104);
    assert_eq(a.digest_len, 32);
    assert_eq(
        a.digest,
        [
            0xec, 0x7e, 0x2e, 0xee, 0x26, 0x75, 0x85, 0x62, 0xc2, 0x79, 0x45, 0xc3, 0x03, 0x75,
            0x0f, 0xa1, 0x8e, 0x2c, 0x49, 0xb0, 0xe5, 0xa2, 0xea, 0xf9, 0x75, 0xbc, 0xc1, 0x7d,
            0x48, 0x31, 0xf1, 0x85, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
            0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
            0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        ],
    );
    let (x, y) = spki_ec(BP256_TBS, f.spki_offset, f.len, curves::BP256);
    assert_eq(
        x,
        [
            0x5a, 0xac, 0x7b, 0x9c, 0xe2, 0xd1, 0x44, 0xdd, 0x89, 0x53, 0x5a, 0x03, 0xf6, 0x2b,
            0xff, 0x5f, 0x8b, 0x05, 0x6a, 0x25, 0x15, 0x44, 0xd0, 0x89, 0xf7, 0x50, 0xbc, 0x08,
            0x10, 0x10, 0xcc, 0x43,
        ],
    );
    assert_eq(
        y,
        [
            0x99, 0x59, 0x54, 0x34, 0x1c, 0x94, 0xc9, 0xd2, 0x0a, 0xa6, 0xcd, 0xf7, 0x55, 0x2c,
            0x65, 0x3f, 0xb7, 0xd2, 0x72, 0x89, 0x21, 0x9e, 0xa9, 0xa7, 0xf8, 0x26, 0x43, 0x3f,
            0x8d, 0xf6, 0x66, 0xb1,
        ],
    );
}

