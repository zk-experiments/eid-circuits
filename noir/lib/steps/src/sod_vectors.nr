pub(crate) global P521_MD_OFFSET: u32 = 56;

#[test]
fn sod_p521() {
    let (f, a) = parse(P521_TBS, P521_ATTRS, P521_MD_OFFSET);
    assert_eq(f.len, 722);
    assert_eq(a.len, 137);
    assert_eq(a.digest_len, 64);
    assert_eq(
        a.digest,
        [
            0x45, 0x5b, 0x7f, 0x75, 0xea, 0x5d, 0x71, 0x6a, 0xc9, 0x6a, 0x3e, 0xe2, 0xcf, 0x65,
            0x20, 0x21, 0x4e, 0x50, 0xd2, 0x70, 0x3b, 0xe1, 0xa1, 0x71, 0x24, 0x48, 0x11, 0x53,
            0xc5, 0xb1, 0xc7, 0x99, 0x48, 0x87, 0x53, 0x3c, 0x37, 0xf0, 0xe3, 0xae, 0xad, 0x9d,
            0x2e, 0x49, 0x4d, 0xe8, 0xd6, 0xd5, 0xd8, 0x58, 0xe6, 0xf8, 0x84, 0x6b, 0x62, 0x60,
            0x32, 0x63, 0x16, 0xbc, 0xa0, 0xf8, 0xcb, 0xdd,
        ],
    );
    let (x, y) = spki_ec(P521_TBS, f.spki_offset, f.len, curves::P521);
    assert_eq(
        x,
        [
            0x01, 0xf5, 0x1a, 0x95, 0x27, 0x87, 0x08, 0x23, 0x0f, 0xca, 0x20, 0x23, 0x2a, 0xad,
            0xdc, 0xd3, 0xd2, 0x32, 0xbe, 0x41, 0xa2, 0x7a, 0x15, 0xd2, 0xb0, 0x63, 0x65, 0x08,
            0xb7, 0x3f, 0xa1, 0x5c, 0xa8, 0x50, 0xaa, 0x06, 0xea, 0x92, 0xd3, 0x99, 0xa9, 0x43,
            0xbf, 0x07, 0x78, 0x45, 0x6c, 0x20, 0x90, 0x5d, 0x57, 0x41, 0x78, 0x98, 0xcd, 0x9d,
            0x73, 0x10, 0xc4, 0xef, 0xac, 0x2f, 0x05, 0xe5, 0xc3, 0xdc,
        ],
    );
    assert_eq(
        y,
        [
            0x01, 0x22, 0x23, 0xd4, 0x02, 0xb9, 0x37, 0x64, 0x3d, 0x9b, 0xcd, 0xb4, 0x7e, 0x71,
            0x20, 0xee, 0x0b, 0x96, 0xef, 0x2d, 0xa0, 0xa1, 0x3c, 0xaf, 0xed, 0x59, 0x59, 0x4f,
            0xe5, 0x8a, 0x36, 0x67, 0x23, 0x2f, 0x2c, 0x7f, 0xd7, 0xcc, 0x9b, 0x7b, 0x69, 0xbf,
            0xcc, 0x4d, 0x56, 0x91, 0xb9, 0xf2, 0x70, 0x58, 0xf0, 0xeb, 0xbb, 0x60, 0xec, 0x95,
            0x8b, 0x07, 0x6f, 0xde, 0xd6, 0x95, 0x44, 0x96, 0x91, 0xfb,
        ],
    );
}
