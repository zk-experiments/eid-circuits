#[test]
fn sod_p256() {
    let (f, a) = parse(P256_TBS, P256_ATTRS, P256_MD_OFFSET);
    assert_eq(f.len, 225);
    assert_eq(a.len, 104);
    assert_eq(a.digest_len, 32);
    assert_eq(
        a.digest,
        [
            0xec, 0x7e, 0x2e, 0xee, 0x26, 0x75, 0x85, 0x62, 0xc2, 0x79, 0x45, 0xc3, 0x03, 0x75,
            0x0f, 0xa1, 0x8e, 0x2c, 0x49, 0xb0, 0xe5, 0xa2, 0xea, 0xf9, 0x75, 0xbc, 0xc1, 0x7d,
            0x48, 0x31, 0xf1, 0x85, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
            0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
            0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        ],
    );
    let (x, y) = spki_ec(P256_TBS, f.spki_offset, f.len, curves::P256);
    assert_eq(
        x,
        [
            0x07, 0x02, 0x04, 0xec, 0x5b, 0xdb, 0xa6, 0xf4, 0x7b, 0x3a, 0xc9, 0xe6, 0xbd, 0x00,
            0x2d, 0xa8, 0xf2, 0xa3, 0x4c, 0x6e, 0xd0, 0x1c, 0x9e, 0x07, 0xfd, 0x50, 0x79, 0xc7,
            0x22, 0x91, 0xd9, 0xa5,
        ],
    );
    assert_eq(
        y,
        [
            0x1e, 0xd8, 0x23, 0x36, 0xbc, 0x9b, 0x2e, 0x0a, 0x2d, 0x01, 0x74, 0x77, 0x9f, 0x63,
            0x7f, 0x35, 0x25, 0x2d, 0x37, 0x23, 0x93, 0x70, 0x67, 0x8c, 0xc7, 0x6a, 0xa5, 0x0d,
            0x60, 0x9d, 0xad, 0x59,
        ],
    );
}

