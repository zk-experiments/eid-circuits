pub(crate) fn pss_sha256_s32_3072_cz_kind() -> KeyKind {
    KeyKind { key_type: 1, curve: 0, bits: 3072 }
}

pub(crate) global PSS_SHA256_S32_3072_CZ_NOT_BEFORE_OFFSET: u32 = 171;
pub(crate) global PSS_SHA256_S32_3072_CZ_SERIAL_OFFSET: u32 = 9;

#[test]
fn pss_sha256_s32_3072_cz() {
    let f = check::<1200, 384, 13>(
        ROOT,
        pss_sha256_s32_3072_cz_witness(),
        pss_sha256_s32_3072_cz_kind(),
    );
    assert_eq(f.len, 1132);
}

