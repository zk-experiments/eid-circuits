pub(crate) fn ecdsa_sha384_p384_bm_kind() -> KeyKind {
    KeyKind { key_type: 2, curve: 4, bits: 384 }
}

pub(crate) global ECDSA_SHA384_P384_BM_NOT_BEFORE_OFFSET: u32 = 91;
pub(crate) global ECDSA_SHA384_P384_BM_SERIAL_OFFSET: u32 = 9;

#[test]
fn ecdsa_sha384_p384_bm() {
    let f = check::<1200, 96, 4>(
        ROOT,
        ecdsa_sha384_p384_bm_witness(),
        ecdsa_sha384_p384_bm_kind(),
    );
    assert_eq(f.len, 1085);
}

