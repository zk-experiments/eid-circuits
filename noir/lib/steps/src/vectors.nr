pub(crate) fn ecdsa_sha256_p256_be_kind() -> KeyKind {
    KeyKind { key_type: 2, curve: 3, bits: 256 }
}

pub(crate) global ECDSA_SHA256_P256_BE_NOT_BEFORE_OFFSET: u32 = 156;
pub(crate) global ECDSA_SHA256_P256_BE_SERIAL_OFFSET: u32 = 9;

#[test]
fn ecdsa_sha256_p256_be() {
    let f = check::<1000, 64, 3>(
        ROOT,
        ecdsa_sha256_p256_be_witness(),
        ecdsa_sha256_p256_be_kind(),
    );
    assert_eq(f.len, 724);
}

