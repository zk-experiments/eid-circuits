pub(crate) fn pkcs1_sha256_4096_ad_kind() -> KeyKind {
    KeyKind { key_type: 1, curve: 0, bits: 4096 }
}

pub(crate) global PKCS1_SHA256_4096_AD_NOT_BEFORE_OFFSET: u32 = 98;
pub(crate) global PKCS1_SHA256_4096_AD_SERIAL_OFFSET: u32 = 9;

#[test]
fn pkcs1_sha256_4096_ad() {
    let f = check::<1000, 512, 17>(
        ROOT,
        pkcs1_sha256_4096_ad_witness(),
        pkcs1_sha256_4096_ad_kind(),
    );
    assert_eq(f.len, 811);
}

