pub(crate) fn pss_sha256_s32_4096_ag_kind() -> KeyKind {
    KeyKind { key_type: 1, curve: 0, bits: 4096 }
}

pub(crate) global PSS_SHA256_S32_4096_AG_NOT_BEFORE_OFFSET: u32 = 150;
pub(crate) global PSS_SHA256_S32_4096_AG_SERIAL_OFFSET: u32 = 9;

#[test]
fn pss_sha256_s32_4096_ag() {
    let f = check::<1200, 512, 17>(
        ROOT,
        pss_sha256_s32_4096_ag_witness(),
        pss_sha256_s32_4096_ag_kind(),
    );
    assert_eq(f.len, 1063);
}

