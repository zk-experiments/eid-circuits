pub(crate) fn pkcs1_sha1_2048_sm_kind() -> KeyKind {
    KeyKind { key_type: 1, curve: 0, bits: 2048 }
}

pub(crate) global PKCS1_SHA1_2048_SM_NOT_BEFORE_OFFSET: u32 = 107;
pub(crate) global PKCS1_SHA1_2048_SM_SERIAL_OFFSET: u32 = 9;

#[test]
fn pkcs1_sha1_2048_sm() {
    let f = check::<700, 256, 9>(
        ROOT,
        pkcs1_sha1_2048_sm_witness(),
        pkcs1_sha1_2048_sm_kind(),
    );
    assert_eq(f.len, 611);
}

