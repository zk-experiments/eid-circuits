pub(crate) fn pss_sha384_s48_3072_mk_kind() -> KeyKind {
    KeyKind { key_type: 1, curve: 0, bits: 3072 }
}

pub(crate) global PSS_SHA384_S48_3072_MK_NOT_BEFORE_OFFSET: u32 = 152;
pub(crate) global PSS_SHA384_S48_3072_MK_SERIAL_OFFSET: u32 = 9;

#[test]
fn pss_sha384_s48_3072_mk() {
    let f = check::<1200, 384, 13>(
        ROOT,
        pss_sha384_s48_3072_mk_witness(),
        pss_sha384_s48_3072_mk_kind(),
    );
    assert_eq(f.len, 1156);
}

