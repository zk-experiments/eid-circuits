pub(crate) fn ecdsa_sha256_p521_lt_kind() -> KeyKind {
    KeyKind { key_type: 2, curve: 5, bits: 521 }
}

pub(crate) global ECDSA_SHA256_P521_LT_NOT_BEFORE_OFFSET: u32 = 84;
pub(crate) global ECDSA_SHA256_P521_LT_SERIAL_OFFSET: u32 = 9;

#[test]
fn ecdsa_sha256_p521_lt() {
    let f = check::<1200, 132, 5>(
        ROOT,
        ecdsa_sha256_p521_lt_witness(),
        ecdsa_sha256_p521_lt_kind(),
    );
    assert_eq(f.len, 1084);
}

