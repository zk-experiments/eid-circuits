pub(crate) fn ecdsa_sha384_bp384_ao_kind() -> KeyKind {
    KeyKind { key_type: 2, curve: 16, bits: 384 }
}

pub(crate) global ECDSA_SHA384_BP384_AO_NOT_BEFORE_OFFSET: u32 = 179;
pub(crate) global ECDSA_SHA384_BP384_AO_SERIAL_OFFSET: u32 = 9;

#[test]
fn ecdsa_sha384_bp384_ao() {
    let f = check::<1200, 96, 4>(
        ROOT,
        ecdsa_sha384_bp384_ao_witness(),
        ecdsa_sha384_bp384_ao_kind(),
    );
    assert_eq(f.len, 1094);
}

