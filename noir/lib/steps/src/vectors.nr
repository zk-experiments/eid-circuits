pub(crate) fn pkcs1_sha256_4096_e107903_ng_kind() -> KeyKind {
    KeyKind { key_type: 1, curve: 0, bits: 4096 }
}

pub(crate) global PKCS1_SHA256_4096_E107903_NG_NOT_BEFORE_OFFSET: u32 = 178;
pub(crate) global PKCS1_SHA256_4096_E107903_NG_SERIAL_OFFSET: u32 = 9;

#[test]
fn pkcs1_sha256_4096_e107903_ng() {
    let f = check::<1200, 512, 17>(
        ROOT,
        pkcs1_sha256_4096_e107903_ng_witness(),
        pkcs1_sha256_4096_e107903_ng_kind(),
    );
    assert_eq(f.len, 1051);
}

