pub(crate) fn ecdsa_sha256_bp256_ae_kind() -> KeyKind {
    KeyKind { key_type: 2, curve: 12, bits: 256 }
}

pub(crate) global ECDSA_SHA256_BP256_AE_NOT_BEFORE_OFFSET: u32 = 93;
pub(crate) global ECDSA_SHA256_BP256_AE_SERIAL_OFFSET: u32 = 9;

#[test]
fn ecdsa_sha256_bp256_ae() {
    let f = check::<1000, 64, 3>(
        ROOT,
        ecdsa_sha256_bp256_ae_witness(),
        ecdsa_sha256_bp256_ae_kind(),
    );
    assert_eq(f.len, 843);
}

