pub(crate) fn ecdsa_sha512_p521_eg_kind() -> KeyKind {
    KeyKind { key_type: 2, curve: 5, bits: 521 }
}

pub(crate) global ECDSA_SHA512_P521_EG_NOT_BEFORE_OFFSET: u32 = 111;
pub(crate) global ECDSA_SHA512_P521_EG_SERIAL_OFFSET: u32 = 9;

#[test]
fn ecdsa_sha512_p521_eg() {
    let f = check::<700, 132, 5>(
        ROOT,
        ecdsa_sha512_p521_eg_witness(),
        ecdsa_sha512_p521_eg_kind(),
    );
    assert_eq(f.len, 633);
}

