pub(crate) fn pkcs1_sha1_4096_cn_kind() -> KeyKind {
    KeyKind { key_type: 1, curve: 0, bits: 4096 }
}

pub(crate) global PKCS1_SHA1_4096_CN_NOT_BEFORE_OFFSET: u32 = 200;
pub(crate) global PKCS1_SHA1_4096_CN_SERIAL_OFFSET: u32 = 9;

#[test]
fn pkcs1_sha1_4096_cn() {
    let f = check::<1200, 512, 17>(
        ROOT,
        pkcs1_sha1_4096_cn_witness(),
        pkcs1_sha1_4096_cn_kind(),
    );
    assert_eq(f.len, 1015);
}

