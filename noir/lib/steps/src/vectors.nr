pub(crate) fn pss_sha512_s20_4096_ee_kind() -> KeyKind {
    KeyKind { key_type: 1, curve: 0, bits: 4096 }
}

pub(crate) global PSS_SHA512_S20_4096_EE_NOT_BEFORE_OFFSET: u32 = 201;
pub(crate) global PSS_SHA512_S20_4096_EE_SERIAL_OFFSET: u32 = 9;

#[test]
fn pss_sha512_s20_4096_ee() {
    let f = check::<1600, 512, 17>(
        ROOT,
        pss_sha512_s20_4096_ee_witness(),
        pss_sha512_s20_4096_ee_kind(),
    );
    assert_eq(f.len, 1249);
}

