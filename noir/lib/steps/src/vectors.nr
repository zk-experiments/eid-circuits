pub(crate) fn ecdsa_sha256_bp512_ng_kind() -> KeyKind {
    KeyKind { key_type: 2, curve: 18, bits: 512 }
}

pub(crate) global ECDSA_SHA256_BP512_NG_NOT_BEFORE_OFFSET: u32 = 112;
pub(crate) global ECDSA_SHA256_BP512_NG_SERIAL_OFFSET: u32 = 9;

#[test]
fn ecdsa_sha256_bp512_ng() {
    let f = check::<1600, 128, 5>(
        ROOT,
        ecdsa_sha256_bp512_ng_witness(),
        ecdsa_sha256_bp512_ng_kind(),
    );
    assert_eq(f.len, 1270);
}

