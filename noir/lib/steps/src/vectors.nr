pub(crate) fn ecdsa_sha1_p256_ru_kind() -> KeyKind {
    KeyKind { key_type: 2, curve: 3, bits: 256 }
}

pub(crate) global ECDSA_SHA1_P256_RU_NOT_BEFORE_OFFSET: u32 = 184;
pub(crate) global ECDSA_SHA1_P256_RU_SERIAL_OFFSET: u32 = 9;

#[test]
fn ecdsa_sha1_p256_ru() {
    let f = check::<1000, 64, 3>(
        ROOT,
        ecdsa_sha1_p256_ru_witness(),
        ecdsa_sha1_p256_ru_kind(),
    );
    assert_eq(f.len, 979);
}

