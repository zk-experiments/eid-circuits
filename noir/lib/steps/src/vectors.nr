pub(crate) fn pkcs1_sha512_4096_au_kind() -> KeyKind {
    KeyKind { key_type: 1, curve: 0, bits: 4096 }
}

pub(crate) global PKCS1_SHA512_4096_AU_NOT_BEFORE_OFFSET: u32 = 133;
pub(crate) global PKCS1_SHA512_4096_AU_SERIAL_OFFSET: u32 = 9;

#[test]
fn pkcs1_sha512_4096_au() {
    let f = check::<1600, 512, 17>(
        ROOT,
        pkcs1_sha512_4096_au_witness(),
        pkcs1_sha512_4096_au_kind(),
    );
    assert_eq(f.len, 1382);
}

