pub(crate) fn ecdsa_sha512_bp256_ba_kind() -> KeyKind {
    KeyKind { key_type: 2, curve: 12, bits: 256 }
}

pub(crate) global ECDSA_SHA512_BP256_BA_NOT_BEFORE_OFFSET: u32 = 109;
pub(crate) global ECDSA_SHA512_BP256_BA_SERIAL_OFFSET: u32 = 9;

#[test]
fn ecdsa_sha512_bp256_ba() {
    let f = check::<1000, 64, 3>(
        ROOT,
        ecdsa_sha512_bp256_ba_witness(),
        ecdsa_sha512_bp256_ba_kind(),
    );
    assert_eq(f.len, 880);
}

