pub(crate) fn ecdsa_sha256_bp384_jo_kind() -> KeyKind {
    KeyKind { key_type: 2, curve: 16, bits: 384 }
}

pub(crate) global ECDSA_SHA256_BP384_JO_NOT_BEFORE_OFFSET: u32 = 125;
pub(crate) global ECDSA_SHA256_BP384_JO_SERIAL_OFFSET: u32 = 9;

#[test]
fn ecdsa_sha256_bp384_jo() {
    let f = check::<1000, 96, 4>(
        ROOT,
        ecdsa_sha256_bp384_jo_witness(),
        ecdsa_sha256_bp384_jo_kind(),
    );
    assert_eq(f.len, 969);
}

