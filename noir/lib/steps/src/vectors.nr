pub(crate) fn pss_sha384_s48_4096_eu_kind() -> KeyKind {
    KeyKind { key_type: 1, curve: 0, bits: 4096 }
}

pub(crate) global PSS_SHA384_S48_4096_EU_NOT_BEFORE_OFFSET: u32 = 187;
pub(crate) global PSS_SHA384_S48_4096_EU_SERIAL_OFFSET: u32 = 9;

#[test]
fn pss_sha384_s48_4096_eu() {
    let f = check::<1600, 512, 17>(
        ROOT,
        pss_sha384_s48_4096_eu_witness(),
        pss_sha384_s48_4096_eu_kind(),
    );
    assert_eq(f.len, 1264);
}

