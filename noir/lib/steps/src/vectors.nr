pub(crate) fn ecdsa_sha512_bp512_br_kind() -> KeyKind {
    KeyKind { key_type: 2, curve: 18, bits: 512 }
}

pub(crate) global ECDSA_SHA512_BP512_BR_NOT_BEFORE_OFFSET: u32 = 187;
pub(crate) global ECDSA_SHA512_BP512_BR_SERIAL_OFFSET: u32 = 9;

#[test]
fn ecdsa_sha512_bp512_br() {
    let f = check::<1200, 128, 5>(
        ROOT,
        ecdsa_sha512_bp512_br_witness(),
        ecdsa_sha512_bp512_br_kind(),
    );
    assert_eq(f.len, 1143);
}
