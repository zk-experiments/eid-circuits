pub(crate) fn ecdsa_sha512_p384_dz_kind() -> KeyKind {
    KeyKind { key_type: 2, curve: 4, bits: 384 }
}

pub(crate) global ECDSA_SHA512_P384_DZ_NOT_BEFORE_OFFSET: u32 = 110;
pub(crate) global ECDSA_SHA512_P384_DZ_SERIAL_OFFSET: u32 = 9;

#[test]
fn ecdsa_sha512_p384_dz() {
    let f = check::<700, 96, 4>(
        ROOT,
        ecdsa_sha512_p384_dz_witness(),
        ecdsa_sha512_p384_dz_kind(),
    );
    assert_eq(f.len, 696);
}

