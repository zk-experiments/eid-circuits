pub(crate) fn ecdsa_sha256_p384_ae_kind() -> KeyKind {
    KeyKind { key_type: 2, curve: 4, bits: 384 }
}

pub(crate) global ECDSA_SHA256_P384_AE_NOT_BEFORE_OFFSET: u32 = 114;
pub(crate) global ECDSA_SHA256_P384_AE_SERIAL_OFFSET: u32 = 9;

#[test]
fn ecdsa_sha256_p384_ae() {
    let f = check::<1000, 96, 4>(
        ROOT,
        ecdsa_sha256_p384_ae_witness(),
        ecdsa_sha256_p384_ae_kind(),
    );
    assert_eq(f.len, 992);
}

