pub(crate) fn pkcs1_sha512_2048_is_kind() -> KeyKind {
    KeyKind { key_type: 1, curve: 0, bits: 2048 }
}

pub(crate) global PKCS1_SHA512_2048_IS_NOT_BEFORE_OFFSET: u32 = 257;
pub(crate) global PKCS1_SHA512_2048_IS_SERIAL_OFFSET: u32 = 9;

#[test]
fn pkcs1_sha512_2048_is() {
    let f = check::<1600, 256, 9>(
        ROOT,
        pkcs1_sha512_2048_is_witness(),
        pkcs1_sha512_2048_is_kind(),
    );
    assert_eq(f.len, 1282);
}

