pub(crate) fn pkcs1_sha384_3072_tj_kind() -> KeyKind {
    KeyKind { key_type: 1, curve: 0, bits: 3072 }
}

pub(crate) global PKCS1_SHA384_3072_TJ_NOT_BEFORE_OFFSET: u32 = 155;
pub(crate) global PKCS1_SHA384_3072_TJ_SERIAL_OFFSET: u32 = 9;

#[test]
fn pkcs1_sha384_3072_tj() {
    let f = check::<1000, 384, 13>(
        ROOT,
        pkcs1_sha384_3072_tj_witness(),
        pkcs1_sha384_3072_tj_kind(),
    );
    assert_eq(f.len, 907);
}

