pub(crate) fn ecdsa_sha1_bp256_lt_kind() -> KeyKind {
    KeyKind { key_type: 2, curve: 12, bits: 256 }
}

pub(crate) global ECDSA_SHA1_BP256_LT_NOT_BEFORE_OFFSET: u32 = 97;
pub(crate) global ECDSA_SHA1_BP256_LT_SERIAL_OFFSET: u32 = 9;

#[test]
fn ecdsa_sha1_bp256_lt() {
    let f = check::<700, 64, 3>(
        ROOT,
        ecdsa_sha1_bp256_lt_witness(),
        ecdsa_sha1_bp256_lt_kind(),
    );
    assert_eq(f.len, 578);
}

