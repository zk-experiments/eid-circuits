pub(crate) fn pss_sha256_s20_4096_il_kind() -> KeyKind {
    KeyKind { key_type: 1, curve: 0, bits: 4096 }
}

pub(crate) global PSS_SHA256_S20_4096_IL_NOT_BEFORE_OFFSET: u32 = 205;
pub(crate) global PSS_SHA256_S20_4096_IL_SERIAL_OFFSET: u32 = 9;

#[test]
fn pss_sha256_s20_4096_il() {
    let f = check::<1000, 512, 17>(
        ROOT,
        pss_sha256_s20_4096_il_witness(),
        pss_sha256_s20_4096_il_kind(),
    );
    assert_eq(f.len, 898);
}

