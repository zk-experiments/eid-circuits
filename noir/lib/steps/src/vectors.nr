pub(crate) fn pkcs1_sha256_6144_md_kind() -> KeyKind {
    KeyKind { key_type: 1, curve: 0, bits: 6144 }
}

pub(crate) global PKCS1_SHA256_6144_MD_NOT_BEFORE_OFFSET: u32 = 138;
pub(crate) global PKCS1_SHA256_6144_MD_SERIAL_OFFSET: u32 = 9;

#[test]
fn pkcs1_sha256_6144_md() {
    let f = check::<1600, 768, 25>(
        ROOT,
        pkcs1_sha256_6144_md_witness(),
        pkcs1_sha256_6144_md_kind(),
    );
    assert_eq(f.len, 1507);
}

