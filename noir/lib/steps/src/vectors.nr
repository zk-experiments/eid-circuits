pub(crate) fn pkcs1_sha256_3072_ar_kind() -> KeyKind {
    KeyKind { key_type: 1, curve: 0, bits: 3072 }
}

pub(crate) global PKCS1_SHA256_3072_AR_NOT_BEFORE_OFFSET: u32 = 123;
pub(crate) global PKCS1_SHA256_3072_AR_SERIAL_OFFSET: u32 = 9;

#[test]
fn pkcs1_sha256_3072_ar() {
    let f = check::<1000, 384, 13>(
        ROOT,
        pkcs1_sha256_3072_ar_witness(),
        pkcs1_sha256_3072_ar_kind(),
    );
    assert_eq(f.len, 817);
}

