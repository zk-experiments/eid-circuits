pub(crate) fn pss_sha256_s32_4096_e3_cn_kind() -> KeyKind {
    KeyKind { key_type: 1, curve: 0, bits: 4096 }
}

pub(crate) global PSS_SHA256_S32_4096_E3_CN_NOT_BEFORE_OFFSET: u32 = 215;
pub(crate) global PSS_SHA256_S32_4096_E3_CN_SERIAL_OFFSET: u32 = 9;

#[test]
fn pss_sha256_s32_4096_e3_cn() {
    let f = check::<1200, 512, 17>(
        ROOT,
        pss_sha256_s32_4096_e3_cn_witness(),
        pss_sha256_s32_4096_e3_cn_kind(),
    );
    assert_eq(f.len, 1002);
}

